# Database (PostgreSQL disarankan untuk production, SQLite cukup untuk development lokal)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Base URL publik aplikasi (dipakai untuk menyusun short link yang ditampilkan di dashboard)
APP_BASE_URL="http://localhost:3000"

# Panjang kode pendek auto-generate
SHORT_CODE_LENGTH=7

# Cache provider: "memory" (default, cukup untuk single-instance/dev) | "redis"
CACHE_PROVIDER="memory"
REDIS_URL=""
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=5000
